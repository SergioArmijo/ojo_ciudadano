# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL + PostGIS) ---
DATABASE_URL=postgis://ojo_user:ojo_pass@localhost:5432/ojo_ciudadano

# --- CORS (orígenes permitidos para el panel admin y la app móvil) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Almacenamiento de evidencias (compatible con S3) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ojo-ciudadano-evidencias
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Redis / Celery (tareas asíncronas, se activa en una etapa posterior) ---
REDIS_URL=redis://localhost:6379/0

# --- Proveedor de IA para OjoBot (se usa solo en el backend, nunca en el móvil ni el panel) ---
AI_PROVIDER_API_KEY=
